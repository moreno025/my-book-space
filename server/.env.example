# ============================================================
# my-book-space — Server Environment Variables
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# Node
NODE_ENV=development

# Servidor
PORT=3000
IP_SERVER_HTTPS=https://your-domain.com

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:8081,https://your-domain.com

# MongoDB Atlas (ver src/config/db.js)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your-cluster.xxxxx.mongodb.net

# JWT Secrets — genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
JWT_EMAIL_CHANGE_SECRET=

# Google OAuth2 (para Nodemailer)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground

# Email
EMAIL_FROM=your_email@example.com
APP_NAME=MyBookSpace

# Deep links de desarrollo (Expo Go) — solo se usan fuera de producción
EXPO_DEV_URL=exp://YOUR_LOCAL_IP:8081

# APIs externas
NYT_API_KEY=
